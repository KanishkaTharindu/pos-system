DJANGO_SECRET_KEY=replace_with_a_long_random_secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Colombo
POS_TAX_RATE=0.10
POS_REQUIRE_OPEN_SHIFT=False

# SMTP is optional. The Email module reports an explicit configuration error when absent.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=

# Optional development seed account passwords (leave empty unless explicitly seeding)
POS_SEED_ADMIN_PASSWORD=
POS_SEED_MANAGER_PASSWORD=
POS_SEED_CASHIER_PASSWORD=

DB_NAME=pos_db
DB_USER=pos_user
DB_PASSWORD=replace_with_a_strong_password
DB_HOST=127.0.0.1
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
